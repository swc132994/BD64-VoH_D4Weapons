Actor D4Chainsaw : BrutalD464Weapon Replaces ChainsawSpawner
{
Scale 0.82
Weapon.SlotNumber 1
Weapon.SlotPriority 2
Weapon.SelectionOrder 2200
Weapon.Kickback 0
Inventory.PickupMessage "$GOTCHAINSAW"
Inventory.PickupSound "Painsaw/Pickup"
Weapon.UpSound "null"
Weapon.AmmoType "SawGas"
Weapon.AmmoUse 1
Weapon.AmmoGive 100
+WEAPON.MELEEWEAPON
+WEAPON.AXEBLOOD
Tag "$TAG_CHAINSAW"
	States
	{
	KickingFlash:
		PS4G A 0
		Goto KickingFrameFlash
	SlideKickingStart:
		PS4G A 0
		Goto SlideKickingFrameStart
	SlideKickingEnd:
		PS4G A 0
		Goto SlideKickingFrameEnd
	Spawn:
		D4W1 B -1
		Stop
	Select:
		PS4G A 0 A_GiveInventory("D4PeaGunSelected",1)
		PS4G A 0 A_GiveInventory("IsD4Weapon",1)
		PS4G A 0 A_PlaySound("Painsaw/Select",CHAN_7)
		Goto SelectAnimation
	Deselect:
		PS4G A 0 A_StopSound(CHAN_WEAPON)
		PS4G A 0 A_StopSound(CHAN_6)
		PS4G A 0 A_TakeInventory("D4PeaGunSelected",0)
		PS4G A 0 A_TakeInventory("IsD4Weapon",0)
		PS4G A 0 A_Takeinventory("WeaponSpecialAction",0)
		PS4G A 0 A_Takeinventory("Kicking",0)
		PS4G A 0 A_PlaySound("Painsaw/DeSelect",7)
		Goto DeselectAnimation
	v1Ready:
	Ready:
		PS4G A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PS4G A 0 A_JumpIfInventory("IsUpgradingWeapons",1,"UpgradeWeapons")
		PS4G A 0 A_JumpIfInventory("SawGas",1,1)
		Goto NotReady
		PS4G A 0 A_PlaySound("Painsaw/Idle",CHAN_6,1,TRUE)
		PS4G AB 6 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PS4G A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		PS4G A 0 A_JumpIfInventory("IsUpgradingWeapons",1,"UpgradeWeapons")
		PS4G A 0 A_JumpIfInventory("SawGas",1,1)
		Goto NotReady
		PS4G A 0 A_PlaySound("Painsaw/Idle",CHAN_6,1,TRUE)
		PS4G AB 6 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
		PS4G A 0 A_TakeInventory("SawGas",1)
		Loop
	NotReady:
		PS4G A 5 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		TNT1 A 0 A_JumpIfInventory("IsUpgradingWeapons",1,"UpgradeWeapons")
		TNT1 A 0 A_JumpIfInventory("SawGas",1,"Select")
		Loop
	Fire:
		TNT1 A 0 A_JumpIfInventory("SawGas",1,1)
		Goto FinishFire
		PS4G A 1 Offset(-5, 35)
		PS4G B 1 Offset(-14, 57)
		PS4G A 1 Offset(-26, 72)
		PS4G B 1 Offset(-39, 87)
		PS4G C 1 Offset(-38, 62)
		PS4G D 1 Offset(-30, 50)
		PS4G C 1 Offset(-15, 35)
		TNT1 A 0 A_StopSound(CHAN_6)
	Hold:	
		TNT1 A 0 A_PlaySound("Painsaw/Loop",CHAN_WEAPON,1,TRUE)
		TNT1 A 0 A_AlertMonsters
		PS4G C 1 Offset(0, 33) A_FireCustomMissile("SawDamage",15)
		PS4G D 1 Offset(1, 34) A_FireCustomMissile("SawDamage",-15,0)
		PS4G C 1 Offset(-1, 34) A_FireCustomMissile("SawDamage",15,0)
		PS4G D 1 Offset(0, 33) A_FireCustomMissile("SawDamage",-15,0)
		TNT1 A 0 A_ReFire
	FinishFire:
		TNT1 A 0 A_StopSound(CHAN_WEAPON)
		PS4G C 1 Offset(-15, 35)
		PS4G D 1 Offset(-30, 50)
		PS4G C 1 Offset(-38, 62)		
		TNT1 A 0 A_PlaySound("Painsaw/LoopEnd",7)
		PS4G B 1 Offset(-39, 87)
		PS4G A 1 Offset(-26, 72)
		PS4G B 1 Offset(-14, 57)
		PS4G A 1 Offset(-5, 35)
		Goto Ready
	}
}
