ACTOR D4Chaingun : BrutalD464Weapon Replaces ChaingunSpawner
{
Weapon.SelectionOrder 700
Weapon.AmmoUse 1
Weapon.AmmoGive 20
Weapon.AmmoType "64HighCaliberBox"
Inventory.PickupSound "Minigun/Pickup"
Inventory.PickupMessage "$GOTCHAINGUN"
Obituary "$OB_MPCHAINGUN"
Tag "$TAG_CHAINGUN"
	States
	{
	Spawn:
		D4W4 B -1
		Stop
	KickingFlash:
		CH1G A 0 A_JumpIfInventory("Spin",1,"KickingSpinFlash")
		CH2A A 0 A_JumpIfInventory("MobileTurretAltActive",1,"KickingFrameFlash")
		CH2G A 0 A_JumpIfInventory("ChaingunMobileTurret",1,3)
		CH1G A 0 A_JumpIfInventory("ChaingunGatlingRotator",1,2)
		CHGG A 0
		"####" A 0
		Goto KickingFrameFlash
	SlideKickingStart:
		CH1G A 0 A_JumpIfInventory("Spin",1,"SlideKickingSpinStart")
		CH2A A 0 A_JumpIfInventory("MobileTurretAltActive",1,"SlideKickingFrameStart")
		CH2G A 0 A_JumpIfInventory("ChaingunMobileTurret",1,3)
		CH1G A 0 A_JumpIfInventory("ChaingunGatlingRotator",1,2)
		CHGG A 0
		"####" A 0
		Goto SlideKickingFrameStart
	SlideKickingEnd:
		CH1G A 0 A_JumpIfInventory("Spin",1,"SlideKickingSpinEnd")	
		CH2A A 0 A_JumpIfInventory("MobileTurretAltActive",1,"SlideKickingFrameEnd")
		CH2G A 0 A_JumpIfInventory("ChaingunMobileTurret",1,3)
		CH1G A 0 A_JumpIfInventory("ChaingunGatlingRotator",1,2)
		CHGG A 0
		"####" A 0
		Goto SlideKickingFrameEnd
	KickingSpinFlash:
		CH1G A 0 A_PlaySound("Chaingun/SpinStartAndLoop",CHAN_5,0.75,true,2.5)
		CH1G ABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Stop
	SlideKickingSpinStart:
		CH1G A 0 A_PlaySound("Chaingun/SpinStartAndLoop",CHAN_5,0.75,true,2.5)
		CH1G ABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCDABCD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
	SlideKickingSpinEnd:
		CH1G A 0 A_PlaySound("Chaingun/SpinStartAndLoop",CHAN_5,0.75,true,2.5)
		CH1G ABCDABCDABCDABCDABCDABCDABCDABCD 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
		Stop		
		
	v1Ready:
	Ready:
		CH2G A 0 A_JumpIfInventory("ChaingunMobileTurret",1,3)
		CH1G A 0 A_JumpIfInventory("ChaingunGatlingRotator",1,2)
		CHGG A 0
		"####" A 1 A_WeaponReady
		"####" A 0 A_JumpIfInventory("IsUpgradingWeapons",1,"UpgradeWeapons")
		"####" A 0 A_JumpIfInventory("Spin",1,"Ready2")
		"####" A 0 A_JumpIfInventory("MobileTurretAltActive",1,"Ready3")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("WeaponAltMode",1,"ChangeMode")
		Loop
	Ready2:
		CH1G ABCD 1 A_WeaponReady
		TNT1 A 0 A_PlaySound("Chaingun/SpinStartAndLoop",CHAN_5,0.75,true,2.5)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		"####" A 0 A_JumpIfInventory("WeaponAltMode",1,"ChangeMode")		
		Loop
	Ready3:
		CH2A A 1 A_WeaponReady
		CH2A A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		Loop
		
	Deselect:
		CH2G A 0 A_JumpIfInventory("ChaingunMobileTurret",1,3)
		CH1G A 0 A_JumpIfInventory("ChaingunGatlingRotator",1,2)
		CHGG A 0
		"####" A 0 A_TakeInventory("MobileTurretAltActive",0)
		"####" A 0 A_TakeInventory("Spin",0)
		"####" A 0 A_TakeInventory("IsD4Weapon",0)
		"####" A 0 A_TakeInventory("D4ChainGunSelected",0)
		"####" A 0 A_TakeInventory("D4AltMode",0)
		"####" A 0 A_StopSound(5)
		Goto DeselectAnimation
	Select:
		CH2G A 0 A_JumpIfInventory("ChaingunMobileTurret",1,3)
		CH1G A 0 A_JumpIfInventory("ChaingunGatlingRotator",1,2)
		CHGG A 0
		"####" A 0 A_GiveInventory("D4ChainGunSelected",1)
		"####" A 0 A_GiveInventory("IsD4Weapon",1)
		"####" A 0 A_StopSound(5)
		"####" A 0
		Goto SelectAnimation
	ChangeMode:
		"####" A 0 A_TakeInventory("WeaponAltMode",1)
		"####" A 0 A_JumpIfInventory("ChaingunMobileTurret",1,"GatlingRotatorCheck")
		"####" A 0 A_JumpIfInventory("ChaingunGatlingRotator",1,"MobileTurretCheck")
		"####" A 0 A_JumpIfInventory("MobileTurretMode",1,"GoToUpgrade")
		"####" A 0 A_JumpIfInventory("GatlingRotatorMode",1,1)
		Goto AboutUpgrade
	GatlingRotatorCheck:
		"####" A 0 A_JumpIfInventory("GatlingRotatorMode",1,"GoToUpgrade")
		Goto OneUpgradeOnly
	MobileTurretCheck:
		"####" A 0 A_JumpIfInventory("MobileTurretMode",1,"GoToUpgrade")
		Goto OneUpgradeOnly
	GoToUpgrade:
		"####" A 0 A_ZoomFactor(1)
		"####" A 0 A_StopSound(5)		
		"####" A 0 A_TakeInventory("MobileTurretAltActive",1)
		"####" A 0 A_TakeInventory("Spin",1)
		"####" A 1 Offset(-11, 37)
		"####" A 1 Offset(-25, 43)
		"####" A 1 Offset(-49, 50)
		"####" A 1 Offset(-64, 64)
		TNT1 A 3 Offset(1,32)
		TNT1 A 0 A_JumpIfInventory("ChaingunMobileTurret",1,2)
		TNT1 A 0 A_JumpIfInventory("MobileTurretMode",1,"MobileTurretUpgrade")
	GatlingRotatorUpgrade:
		TNT1 A 0 A_Print("Gatling Rotator Selected",2)
		TNT1 A 0 A_PlaySound("Chaingun/SwitchToRotator",1)
		CH1S ABCDDEFGHHIIJKLLMM 1
		TNT1 A 0 A_JumpIfInventory("ChaingunMobileTurret",1,"FromTurretToRotator")
		CH1S O 1 Offset(10, 43) A_GiveInventory("ChaingunGatlingRotator",1)
		CH1S O 1 Offset(6, 37)
		CH1S O 1 Offset(4, 35)
		CH1S O 1 Offset(1, 33)
		Goto FinishGatlingRotatorUpgrade
	FromTurretToRotator:
		CH1S O 1 Offset(10, 43) A_TakeInventory("ChaingunMobileTurret",1)
		CH1S O 1 Offset(6, 37) A_GiveInventory("ChaingunGatlingRotator",1)
		CH1S O 1 Offset(4, 35)
		CH1S O 1 Offset(1, 33)	
	FinishGatlingRotatorUpgrade:
		CH1S RRSSTTUUVVWX 1
		CH1S Y 1 Offset(-12, 45)
		CH1S Y 1 Offset(-6, 38)
		CH1S Y 1 Offset(-3, 36)
		CH1S Y 1 Offset(-1, 33)
		CH1S Z 2
		CH1S "[\]" 2
		Goto Ready
	MobileTurretUpgrade:
		TNT1 A 0 A_Print("Mobile Turret Selected",2)
		TNT1 A 0 A_PlaySound("Chaingun/SwitchToTurret",1)		
		CH2S ABCDEFGHHI 1
		CH2S JKL 1
		TNT1 A 0 A_JumpIfInventory("ChaingunGatlingRotator",1,"FromRotatorToTurret")
		CH2S L 1 Offset(10, 43) A_GiveInventory("ChaingunMobileTurret",1)
		CH2S L 1 Offset(6, 37)
		CH2S L 1 Offset(4, 35)
		CH2S L 1 Offset(1, 33)
		Goto FinishMobileTurretUpgrade
	FromRotatorToTurret:
		CH2S L 1 Offset(10, 43) A_TakeInventory("ChaingunGatlingRotator",1)
		CH2S L 1 Offset(6, 37) A_GiveInventory("ChaingunMobileTurret",1)
		CH2S L 1 Offset(4, 35)
		CH2S L 1 Offset(1, 33)
	FinishMobileTurretUpgrade:
		CH2S MNOP 2
		CH2S QRS 2
		CH2G F 2
		CH2S QRS 1
		CH2G FEE 1
		Goto Ready
