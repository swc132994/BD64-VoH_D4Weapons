	Hold:
		CH2F A 0 A_JumpIfInventory("ChaingunMobileTurret",1,3)
		CH1F A 0 A_JumpIfInventory("ChaingunGatlingRotator",1,2)
		CHGF A 0
		"####" AA 0 A_FireCustomMissile("GunFireSmoke",0,0)
		"####" A 0 A_JumpIfInventory("IsCrouching",1,3)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle2",20,5,40)
		"####" A 0 A_Jump(256,2)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle2",20,5,22)
		"####" A 0 A_FireCustomMissile("TracerChaingun",random(-3,3),0,-1,-12,0,random(-2,2))
		"####" A 0 A_PlaySound("Chaingun/Fire",CHAN_WEAPON)
		"####" A 0 A_SetPitch(pitch-1.2,SPF_INTERPOLATE)
		"####" B 1 Bright offset(-1,33) A_FireBullets(3.5,3.5,-1,8,"MachineGunBulletPuff")
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_Quake(2,8,0,0,0)
		"####" C 1 Bright offset(1,32) A_SetPitch(pitch+0.8,SPF_INTERPOLATE)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_FireCustomMissile("ChaingunCaseSpawn",0,0,6,-15)
		"####" A 0 A_SetAngle(angle + random(-1,1))
		"####" AA 0 A_FireCustomMissile("GunFireSmoke",0,0)
		"####" A 0 A_JumpIfInventory("IsCrouching",1,3)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle2",20,5,40)
		"####" A 0 A_Jump(256,2)
		"####" A 0 A_SpawnItemEx("PlayerMuzzle2",20,5,22)
		"####" A 0 A_FireCustomMissile("TracerChaingun",random(-3,5),0,-1,-12,0,random(-2,2))
		"####" A 0 A_PlaySound("Chaingun/Fire",CHAN_WEAPON)
		"####" A 0 A_SetPitch(pitch-1.2,SPF_INTERPOLATE)
		"####" D 1 Bright offset(1,33) A_FireBullets(3.5,3.5,-1,8,"MachineGunBulletPuff")
		"####" A 0 A_ZoomFactor(0.98)
		"####" A 0 A_Quake(2,8,0,0,0)
		"####" A 1 Bright offset(-1,32) A_SetPitch(pitch+0.8,SPF_INTERPOLATE)
		"####" A 0 A_ZoomFactor(1.0)
		"####" A 0 A_FireCustomMissile("ChaingunCaseSpawn",0,0,6,-15)
		"####" A 0 A_SetAngle(angle + random(-1,1))
		"####" A 0 A_Refire("Hold")
		"####" A 0 A_JumpIfInventory("Spin",1,"Ready2")
		"####" A 0 A_TakeInventory("Spin",1)
		"####" A 0 A_PlaySound("Chaingun/SpinStop",CHAN_5,0.75,false,2.5)
	EndFire4:
		CH2G A 0 A_JumpIfInventory("ChaingunMobileTurret",1,3)
		CH1G A 0 A_JumpIfInventory("ChaingunGatlingRotator",1,2)
		CHGG A 0
		"####" ABCDABCDABCDABCD 1
		"####" A 0 A_Refire("Fire4")
		"####" A 0 A_WeaponReady(WRF_NOBOB)
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
	EndFire3:
		"####" ABCDABCDABCD 2
		"####" A 0 A_Refire("Fire3")
		"####" A 0 A_WeaponReady(WRF_NOBOB)
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
	EndFire2:
		"####" ABCDABCD 2
		"####" A 0 A_Refire("Fire2")
		"####" A 0 A_WeaponReady(WRF_NOBOB)
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
	EndFire1:
		"####" ABCD 3
		"####" A 0 A_Refire("Fire1")
		"####" A 0 A_WeaponReady(WRF_NOBOB)
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
	EndFire:
		"####" ABCD 4
		"####" A 0 A_Refire("Fire")
		"####" A 0 A_WeaponReady(WRF_NOBOB)
		"####" A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		Goto Ready
	TurretFire:
		CH2A A 0 A_PlaySound("Chaingun/TurretStartAndLoop",CHAN_5,1.0,true,0.9)
		CH2A AAAAAA 0 A_FireCustomMissile("GunFireSmoke",0,0)
		CH2A A 0 A_JumpIfInventory("IsCrouching",1,3)
		CH2A A 0 A_SpawnItemEx("PlayerMuzzle2",20,5,40)
		CH2A A 0 A_Jump(256,2)
		CH2A A 0 A_SpawnItemEx("PlayerMuzzle2",20,5,22)
		CH2A A 0 A_FireCustomMissile("TracerChaingun",random(-3,3),0,-1,-12,0,random(-2,2))
		CH2A A 0 A_SetPitch(pitch-1.2,SPF_INTERPOLATE)	
		CH2A E 1 BRIGHT A_FireBullets(3.5,3.5,-1,8,"MachineGunBulletPuff")
		CH2A A 0 A_ZoomFactor(0.98)
		CH2A A 0 A_Quake(2,8,0,0,0)
		CH2A F 1 A_SetPitch(pitch+0.8,SPF_INTERPOLATE)
		CH2A A 0 A_ZoomFactor(1.0)
		CH2A A 0 A_FireCustomMissile("ChaingunCaseSpawn",0,0,6,-15)
		CH2A A 0 A_SetAngle(angle + random(-1,1))
		CH2A AAAAAA 0 A_FireCustomMissile("GunFireSmoke",0,0)
		CH2A A 0 A_JumpIfInventory("IsCrouching",1,3)
		CH2A A 0 A_SpawnItemEx("PlayerMuzzle2",20,5,40)
		CH2A A 0 A_Jump(256,2)
		CH2A A 0 A_SpawnItemEx("PlayerMuzzle2",20,5,22)
		CH2A A 0 A_FireCustomMissile("TracerChaingun",random(-3,5),0,-1,-12,0,random(-2,2))
		CH2A A 0 A_SetPitch(pitch-1.2,SPF_INTERPOLATE)		
		CH2A G 1 BRIGHT A_FireBullets(3.5,3.5,-1,8,"MachineGunBulletPuff")
		CH2A A 0 A_ZoomFactor(0.98)
		CH2A A 0 A_Quake(2,8,0,0,0)
		CH2A H 1 A_SetPitch(pitch+0.8,SPF_INTERPOLATE)
		CH2A A 0 A_ZoomFactor(1.0)
		CH2A A 0 A_FireCustomMissile("ChaingunCaseSpawn",0,0,6,-15)
		CH2A A 0 A_SetAngle(angle + random(-1,1))		
		CH2A A 0 A_Refire("TurretFire")
		CH2A A 0 A_PlaySound("Chaingun/TurretEnd",5,1.0,false,2.5)
		CH2A A 0 A_StopSound(6)
		CH2A ABCD 1
		CH2A AB 2
		CH2A CD 3
		Goto Ready3		
	AltFire:
		CH2G A 0 A_JumpIfInventory("ChaingunMobileTurret",1,"AltFireMobileTurret")
		CH1G A 0 A_JumpIfInventory("ChaingunGatlingRotator",1,"AltFireGatlingRotator")
		Goto AboutUpgrade
	AltFireGatlingRotator:
		CH1G A 0 A_JumpIfInventory("Spin",1,"AltFireGatlingRotatorStop")
		CH1G A 0 A_PlaySound("Chaingun/SpinStartAndLoop",CHAN_WEAPON,0.75,false,2.5)
		CH1G ABCD 4
		CH1G ABCD 3
		CH1G ABCD 2
		CH1G A 0 A_GiveInventory("Spin",1)
		Goto Ready2
	AltFireGatlingRotatorStop:
		CH1G A 0 A_TakeInventory("Spin",1)
		CH1G A 0 A_StopSound(CHAN_5)
		CH1G A 0 A_PlaySound("Chaingun/SpinStop",CHAN_WEAPON,0.75,false,2.5)
		Goto EndFire4
	AltFireMobileTurret:
		CH2A A 0 A_JumpIfInventory("MobileTurretAltActive",1,"AltFireMobileTurretStop")
		CH2A A 0 A_PlaySound("Chaingun/ReadyTurret",5)
		CH2G EEFGHHHH 1
		CH2G IJ 2
		CH2A A 0 A_GiveInventory("MobileTurretAltActive",1)
		Goto Ready3
	AltFireMobileTurretStop:
		CH2A A 0 A_TakeInventory("MobileTurretAltActive",1)
		CH2A A 0 A_PlaySound("Chaingun/UnreadyTurret",5)
		CH2G JI 2	
		CH2G HHGFEE 1
		Goto Ready
	}
}

