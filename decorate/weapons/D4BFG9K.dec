ACTOR D4BFG : BrutalD464Weapon Replaces BFG9000Spawner
{
Weapon.SelectionOrder 2800
Weapon.AmmoUse 40
Weapon.AmmoGive 40
Weapon.AmmoType "Cell"
Inventory.PickupSound "D4BFG/Pickup"
Inventory.PickupMessage "$GOTBFG9000"
Obituary "$OB_MPBFG_MBF"
Tag "$TAG_BFG9000"
	States
	{
	Spawn:
		D4W7 A -1
		Stop
	KickingFlash:
		BFGI A 0
		Goto KickingFrameFlash
	SlideKickingStart:
		BFGI A 0
		Goto SlideKickingFrameStart
	SlideKickingEnd:
		BFGI A 0
		Goto SlideKickingFrameEnd
	v1Ready:
	Ready:
		BFGI A 1 A_WeaponReady
		TNT1 A 0 A_JumpIfInventory("IsUpgradingWeapons",1,"UpgradeWeapons")
		TNT1 A 0 A_JumpIfInventory("Kicking",1,"DoKick")
		TNT1 A 0 A_JumpIfInventory("WeaponAltMode",1,"ChangeMode")
		Loop
	ChangeMode:
		TNT1 A 0 A_TakeInventory("WeaponAltMode",1)
		TNT1 A 0 A_JumpIfInventory("ClassicBFG",1,"ClassicUpgradeCheck")
		TNT1 A 0 A_JumpIfInventory("RapidFireBFG",1,"RapidFireUpgradeCheck")
		TNT1 A 0 A_JumpIfInventory("ClassicMode",1,"GoToUpgrade")
		TNT1 A 0 A_JumpIfInventory("RapidFireMode",1,1)
		Goto AboutUpgrade
	GoToUpgrade:
		BFGI A 1 Offset(2, 37)
		BFGI A 1 Offset(4, 42)
		BFGI A 1 Offset(7, 47)
		BFGI A 1 Offset(10, 52)
		BFGI A 8
		TNT1 A 0 A_JumpIfInventory("ClassicBFG",1,2)
		TNT1 A 0 A_JumpIfInventory("ClassicMode",1,"ClassicUpgrade")
	RapidFireUpgrade:
		TNT1 A 0 A_Print("Rapid Fire Mode Selected",2)
		BFGI A 1 Offset(13, 56)
		BFGI A 0 A_JumpIfInventory("RapidFireBFG",1,"FromRapidToClassic")
		BFGI A 1 Offset(16, 59)
		BFGI A 3 Offset(19, 62) A_GiveInventory("RapidFireBFG",1)
	FinishUpgrade:
		BFGI A 1 Offset(16, 59)
		BFGI A 1 Offset(13, 56)
		BFGI A 1 Offset(11, 53)
		BFGI A 1 Offset(7, 47)
		BFGI A 1 Offset(4, 42)
		BFGI A 1 Offset(2, 37)
		Goto Ready
	FromRapidToClassic:
		BFGI A 1 Offset(16, 59) A_TakeInventory("RapidFireBFG",1)
		BFGI A 3 Offset(19, 62) A_GiveInventory("ClassicBFG",1)
		Goto FinishUpgrade
	ClassicUpgradeCheck:
		TNT1 A 0 A_JumpIfInventory("ClassicMode",1,"GoToUpgrade")
		Goto OneUpgradeOnly
	RapidFireUpgradeCheck:
		TNT1 A 0 A_JumpIfInventory("RapidFireMode",1,"GoToUpgrade")
		Goto OneUpgradeOnly
	ClassicUpgrade:
		TNT1 A 0 A_Print("Classic Mode Selected",2)
		BFGI A 1 Offset(13, 56)
		BFGI A 0 A_JumpIfInventory("ClassicBFG",1,"FromClassicToRapid")
		BFGI A 1 Offset(16, 59)
		BFGI A 3 Offset(19, 62) A_GiveInventory("ClassicBFG",1)
		Goto FinishUpgrade
	FromClassicToRapid:
		BFGI A 1 Offset(16, 59) A_TakeInventory("ClassicBFG",1)
		BFGI A 3 Offset(19, 62) A_GiveInventory("RapidFireBFG",1)
		Goto FinishUpgrade
	Deselect:
		TNT1 A 0 A_TakeInventory("IsD4Weapon",0)
		TNT1 A 0 A_TakeInventory("D4BFGSelected",0)
		BFGI A 0
		Goto DeselectAnimation
	Select:
		TNT1 A 0 A_GiveInventory("D4BFGSelected",1)
		TNT1 A 0 A_GiveInventory("IsD4Weapon",1)
		BFGI A 0
		Goto SelectAnimation
	Fire:
		TNT1 A 0 A_PlaySound("D4BFG/Charge",0)
		BF4C A 0 BRIGHT A_PlaySound("D4BFG/ChargeLoop",6,1,1)
		BFGD A 1 Bright A_ZoomFactor(1.000,ZOOM_NOSCALETURNING)
		BFGD A 1 Bright A_ZoomFactor(0.998,ZOOM_NOSCALETURNING)
		BFGD B 1 Bright A_ZoomFactor(0.996,ZOOM_NOSCALETURNING)
		BFGD B 1 Bright A_ZoomFactor(0.994,ZOOM_NOSCALETURNING)
		BFGE A 1 Bright A_ZoomFactor(0.990,ZOOM_NOSCALETURNING)
		BFGE A 1 Bright A_ZoomFactor(0.986,ZOOM_NOSCALETURNING)
		BFGE B 1 Bright A_ZoomFactor(0.981,ZOOM_NOSCALETURNING)
		BFGE B 1 Bright A_ZoomFactor(0.975,ZOOM_NOSCALETURNING)
		BFGE C 1 Bright A_ZoomFactor(0.969,ZOOM_NOSCALETURNING)
		BFGE C 1 Bright A_ZoomFactor(0.961,ZOOM_NOSCALETURNING)
		BFGE D 1 Bright A_ZoomFactor(0.953,ZOOM_NOSCALETURNING)
		BFGE D 1 Bright A_ZoomFactor(0.944,ZOOM_NOSCALETURNING)
		BFGE E 1 Bright A_ZoomFactor(0.935,ZOOM_NOSCALETURNING)
		BFGE E 1 Bright A_ZoomFactor(0.925,ZOOM_NOSCALETURNING)
		BFGE F 1 Bright A_ZoomFactor(0.914,ZOOM_NOSCALETURNING)
		BFGE F 1 Bright A_ZoomFactor(0.902,ZOOM_NOSCALETURNING)
		BFGE G 1 Bright A_ZoomFactor(0.889,ZOOM_NOSCALETURNING)
		BFGE G 1 Bright A_ZoomFactor(0.876,ZOOM_NOSCALETURNING)
		BFGE H 1 Bright A_ZoomFactor(0.863,ZOOM_NOSCALETURNING)
		BFGE I 1 Bright A_ZoomFactor(0.833,ZOOM_NOSCALETURNING)
		BFGE J 1 Bright A_ZoomFactor(0.801,ZOOM_NOSCALETURNING)
		BFGE K 1 Bright A_ZoomFactor(0.766,ZOOM_NOSCALETURNING)
		BFGE L 1 Bright offset(2,37) A_ZoomFactor(0.729,ZOOM_NOSCALETURNING)
		BFGE L 1 Bright offset(4,42) A_ZoomFactor(0.710,ZOOM_NOSCALETURNING)
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_JumpIfInventory("IsCrouching",1,3)
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle5",20,5,40)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle5",20,5,22)
		TNT1 A 0 A_ZoomFactor(1,ZOOM_NOSCALETURNING)
		TNT1 A 0 A_PlaySound("D4BFG/Fire",1)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("64BFGBallDeathSound",0,1,6,-3,0,0)
	FireAnimation:
		BFGF A 1 Bright offset(7,47)
		BFGF A 1 Bright offset(10,52)
		BFGF B 2 Bright
		BFGF CC 1 Bright A_SetPitch(pitch+0.5)
		BFGF DD 1 Bright offset(9,50) A_SetPitch(pitch+0.5)
		BFGF EE 1 Bright offset(8,48) A_SetPitch(pitch+0.5)
		BFGF FF 1 Bright offset(7,46) A_SetPitch(pitch+0.5)
		BFGG AA 1 Bright offset(6,44) A_SetPitch(pitch+0.5)
		BFGG BB 2 Bright offset(5,42) A_SetPitch(pitch+0.5)
		BFGG C 2 Bright offset(4,40) A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_ALLOWZOOM)
		BFGG C 2 Bright offset(3,38) A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_ALLOWZOOM)
		BFGG D 2 Bright offset(2,36) A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_ALLOWZOOM)
		BFGG E 2 Bright offset(1,32) A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_ALLOWZOOM)
		BFGG F 2 Bright A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_ALLOWZOOM)
		BFGI A 6 A_WeaponReady(1)
		Goto Ready
	AltFire:
		TNT1 A 0 A_JumpIfInventory("RapidFireBFG",1,"RapidFire")
		TNT1 A 0 A_JumpIfInventory("ClassicBFG",1,"ClassicFire")
		Goto AboutUpgrade
	RapidFire:
		TNT1 A 0 A_JumpIfInventory("Cell",10,1)
		Goto NoAmmo
		TNT1 A 0 BRIGHT A_PlaySound("D4BFG/MiniCharge",7)
		BFGD A 1 Bright A_ZoomFactor(0.998,ZOOM_NOSCALETURNING)
		BFGD B 1 Bright A_ZoomFactor(0.994,ZOOM_NOSCALETURNING)
		BFGE A 1 Bright A_ZoomFactor(0.986,ZOOM_NOSCALETURNING)
		BFGE B 1 Bright A_ZoomFactor(0.975,ZOOM_NOSCALETURNING)
		BFGE C 1 Bright A_ZoomFactor(0.961,ZOOM_NOSCALETURNING)
		BFGE D 1 Bright A_ZoomFactor(0.944,ZOOM_NOSCALETURNING)
		BFGE E 1 Bright A_ZoomFactor(0.925,ZOOM_NOSCALETURNING)
		BFGE F 1 Bright A_ZoomFactor(0.902,ZOOM_NOSCALETURNING)
		BFGE G 1 Bright A_ZoomFactor(0.876,ZOOM_NOSCALETURNING)
		BFGE H 1 Bright A_ZoomFactor(0.863,ZOOM_NOSCALETURNING)
		BFGE I 1 Bright A_ZoomFactor(0.833,ZOOM_NOSCALETURNING)
		BFGE J 1 Bright A_ZoomFactor(0.801,ZOOM_NOSCALETURNING)
		BFGE K 1 Bright A_ZoomFactor(0.766,ZOOM_NOSCALETURNING)
		BFGE L 1 Bright offset(4,42) A_ZoomFactor(0.710,ZOOM_NOSCALETURNING)
	AltHold:
		TNT1 A 0 A_JumpIfInventory("Cell",10,"ActualAltHold")
		Goto NoAmmo
	ActualAltHold:
		TNT1 A 0 A_ZoomFactor(1,ZOOM_NOSCALETURNING)
		TNT1 A 0 A_SetPitch(pitch-6.0)
		TNT1 A 0 A_TakeInventory("Cell",10)
		TNT1 A 0 A_PlaySound("D4BFG/MiniFire",1)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("PurgeBolt",0,1,6,-3)
		TNT1 A 0 A_JumpIfInventory("IsCrouching",1,3)
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle5",20,5,40)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle5",20,5,22)
		BFGF A 1 Bright offset(7,47)
		BFGF A 1 Bright offset(10,52)
		BFGF B 2 Bright 
		BFGF CC 1 Bright A_SetPitch(pitch+0.5)
		BFGF DD 1 Bright offset(9,50) A_SetPitch(pitch+0.5)
		BFGF EE 1 Bright offset(8,48) A_SetPitch(pitch+0.5)
		BFGF FF 1 Bright offset(7,46) A_SetPitch(pitch+0.5)
		"####" "#" 0 A_Refire("2degrees2refire")
		BFGG AA 1 Bright offset(6,44) A_SetPitch(pitch+0.5)
		"####" "#" 0 A_Refire("1degree2refire")
		BFGG BB 2 Bright offset(5,42) A_SetPitch(pitch+0.5)
		"####" "#" 0 A_Refire("VolleyRefire")
		BFGG C 2 Bright offset(4,40) A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_ALLOWZOOM)
		BFGG C 2 Bright offset(3,38) A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_ALLOWZOOM)
		BFGG D 2 Bright offset(2,36) A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_ALLOWZOOM)
		BFGG E 2 Bright offset(1,32) A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_ALLOWZOOM)
		BFGG F 2 Bright A_WeaponReady(WRF_NOFIRE|WRF_NOBOB|WRF_ALLOWZOOM)
		TNT1 A 0 A_Refire
		BFGI A 6 A_WeaponReady(1)
		Goto Ready
	"2degrees2refire":
		"####" "#" 0 A_SetPitch(pitch+2.0)
		Goto VolleyRefire
	"1degree2refire":
		"####" "#" 0 A_SetPitch(pitch+1.0)
		Goto VolleyRefire
	VolleyRefire:
		Goto ActualAltHold
	ClassicFire:
		TNT1 A 0 A_JumpIfInventory("Cell",100,1)
		Goto NoAmmo
		TNT1 A 0 A_PlaySound("D4BFG/Charge2",0)
		BF4C A 0 BRIGHT A_PlaySound("D4BFG/ChargeLoop2",6,1,1)
		BFGD A 2 Bright A_ZoomFactor(0.998,ZOOM_NOSCALETURNING)
		BFGD B 2 Bright A_ZoomFactor(0.994,ZOOM_NOSCALETURNING)
		BFGE A 2 Bright A_ZoomFactor(0.986,ZOOM_NOSCALETURNING)
		BFGE B 2 Bright A_ZoomFactor(0.975,ZOOM_NOSCALETURNING)
		BFGE C 2 Bright A_ZoomFactor(0.961,ZOOM_NOSCALETURNING)
		BFGE D 2 Bright A_ZoomFactor(0.944,ZOOM_NOSCALETURNING)
		BFGE E 2 Bright A_ZoomFactor(0.925,ZOOM_NOSCALETURNING)
		BFGE F 2 Bright A_ZoomFactor(0.902,ZOOM_NOSCALETURNING)
		BFGE G 2 Bright A_ZoomFactor(0.876,ZOOM_NOSCALETURNING)
		BFGE H 2 Bright A_ZoomFactor(0.863,ZOOM_NOSCALETURNING)
		BFGE I 2 Bright A_ZoomFactor(0.833,ZOOM_NOSCALETURNING)
		BFGE J 2 Bright A_ZoomFactor(0.801,ZOOM_NOSCALETURNING)
		BFGE K 2 Bright A_ZoomFactor(0.766,ZOOM_NOSCALETURNING)
		BFGE L 2 Bright offset(4,42) A_ZoomFactor(0.710,ZOOM_NOSCALETURNING)
		TNT1 A 0 A_StopSound(6)
		TNT1 A 0 A_JumpIfInventory("IsCrouching",1,3)
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle5",20,5,40)
		TNT1 A 0 A_Jump(256,2)
		TNT1 A 0 A_SpawnItemEx("PlayerMuzzle5",20,5,22)
		TNT1 A 0 A_PlaySound("D4BFG/Fire2",1)
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_FireCustomMissile("64BFGBallHuge",0,1,6,-3,0,0)
		TNT1 A 0 A_ZoomFactor(1,ZOOM_NOSCALETURNING)
		TNT1 A 0 A_SetPitch(pitch-8.0)
		TNT1 A 0 A_TakeInventory("Cell",100)
		Goto FireAnimation
	}
}

Actor 64BFGBallDeathSound : 64BFGBall
{
DeathSound "D4BFG/BallImpact"
}

ACTOR PurgeBolt : BaronBall
{
Scale 1.6
Damage 28
Speed 30
Radius 10
Height 16
Alpha 0.9
RenderStyle Add
SeeSound ""
DeathSound "D4BFG/MiniImpact"
Decal "Scorch"
DamageType "BFG"	// WAS desintegrate
+RANDOMIZE
+FORCEXYBILLBOARD
+THRUGHOST
+DONTSPLASH
	States
	{
	Spawn:
		TNT1 A 0 NoDelay A_SpawnItemEx("GreenFlare22")
		TNT1 A 0 A_RadiusThrust(-100,100)
		FRPG K 1 Bright Light("BFGBALL_X5")
		Loop
	Death:
		TNT1 A 0 A_SpawnItemEx("DetectFloorCrater")
		TNT1 A 0 A_SpawnItemEx("DetectCeilCrater")
		TNT1 A 0 Radius_Quake(2,54,0,15,0)
		TNT1 A 0 A_RadiusThrust(-900,600)
		BFE1 A 1 Bright Light("BFGBALL_X5") A_Explode(30,100,1)
		TNT1 A 0 A_RadiusThrust(-900,600)
		BFE1 B 1 Bright Light("BFGBALL_X5") A_Explode(30,100,1)
		TNT1 A 0 A_RadiusThrust(-900,600)
		BFE1 C 1 Bright Light("BFGBALL_X5") A_Explode(30,100,1)
		TNT1 A 0 A_RadiusThrust(-900,600)
		BFE1 D 1 Bright Light("BFGBALL_X5") A_Explode(30,100,1)
		TNT1 A 0 A_RadiusThrust(-900,600)
		BFE1 EF 1 Bright Light("BFGBALL_X5") A_Explode(30,100,1)
		Stop
	}
}

Actor 64BFGBallHuge : BFGBall
{
Damage 250
Speed 5
Scale 0.75
Radius 8
Height 8
Renderstyle Normal
DamageType "BFG"
Decal "BFGLIGHTNING"
DeathSound "D4BFG/BallImpact2"
+EXTREMEDEATH
+FRIENDLY
	states
	{
	Spawn:
		TNT1 A 0 A_SpawnItemEx("64BFGBallHugeTracerSpawner")
		BFS1 A 1 Bright A_SpawnItemEx("BFGFlareHuge")
		TNT1 A 0 A_SpawnItemEx("64BFGBallHugeTracerSpawner")
		BFS1 A 1 Bright A_SpawnItemEx("BFGFlareHuge")
		TNT1 A 0 A_SpawnItemEx("64BFGBallHugeTracerSpawner")
		BFS1 B 1 Bright A_SpawnItemEx("BFGFlareHuge")
		TNT1 A 0 A_SpawnItemEx("64BFGBallHugeTracerSpawner")
		BFS1 B 1 Bright A_SpawnItemEx("BFGFlareHuge")
		Loop
	Death:
		TNT1 AAAAA 0 A_CustomMissile("ExplosionParticleGreenHeavy",0,0,random(0,360),2,random(10,70))
		TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile("ExplosionParticleGreenHeavySmall",0,0,random(0,360),2,random(20,50))
		TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_CustomMissile("ExplosionParticleGreenVeryFast",0,0,random(0,360),2,random(20,40))
		TNT1 AAAAAAAAAAAAAA 0 A_CustomMissile("ExplosionParticleGreen",0,0,random(0,360),2,random(0,360))
		TNT1 AAAAAAAAAAAA 0 A_CustomMissile("64BFGFireBaseHuge",0,0,random(0,360),2,random(0,360))
		TNT1 AAAA 0 A_CustomMissile("ExplosionSmokeFast22",0,0,random(0,360),2,random(0,360))
		TNT1 A 0 A_SpawnItemEx("DetectFloorCrater")
		TNT1 A 0 A_SpawnItemEx("DetectCeilCrater")
		TNT1 A 0 A_SpawnItemEx("ExplosionAirDisplacementEffect")
		TNT1 A 0 Radius_Quake(4,8,0,12,0)
		TNT1 A 0 A_Explode(200,180,0)
		TNT1 A 2
		TNT1 A 0 A_SpawnItemEx("LiquidExplosionEffectSpawner")
		BFE1 A 8 BRIGHT
		BFE1 B 7 BRIGHT A_FadeOut(0.14)
		BFE1 C 3 BRIGHT A_FadeOut(0.14)
		TNT1 A 0 A_BFGSpray("64BFGExtraHuge",50)
		BFE1 D 3 BRIGHT A_FadeOut(0.14)
		BFE1 E 3 BRIGHT A_FadeOut(0.14)
		BFE1 F 3 BRIGHT A_FadeOut(0.14)
		Stop
	}
}

ACTOR 64BFGBallHugeTracerSpawner     
{
    Radius 6
    Height 8
    Speed 1
    Damage 0
    -BLOODSPLATTER 
    +NOBOSSRIP
    +NOBLOOD 
    +PAINLESS 
    +RIPPER
    +DOOMBOUNCE
    +NOTIMEFREEZE
	+FRIENDLY
    BloodType AXEDT
    Scale 1
    DAMAGETYPE "BFGD"
    PROJECTILE
    RENDERSTYLE ADD
    +CLIENTSIDEONLY
    ALPHA 0.6
    States
    {
    Spawn:
       TNT1 A 0 Bright
       TNT1 A 1 Bright A_SpawnItemEx("64BFGBallHugeTracer",0,0,0,3,0,0,  0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
       TNT1 A 1 Bright A_SpawnItemEx("64BFGBallHugeTracer",0,0,0,3,0,0,  60,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
       TNT1 A 1 Bright A_SpawnItemEx("64BFGBallHugeTracer",0,0,0,3,0,0,  120,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS) 
	   Stop
    }
}

ACTOR 64BFGBallHugeTracer
{  
    MONSTER
    Radius 1
    Height 1
    Speed 0
    +PAINLESS
    -BLOODSPLATTER 
    +NOBOSSRIP
    +NOBLOOD 
    +NOTIMEFREEZE
    +NOGRAVITY
    +NOCLIP
    +LOOKALLAROUND
    +MISSILEMORE
    +MISSILEEVENMORE
	+FRIENDLY
    -SOLID
    -SHOOTABLE
	DAMAGETYPE "BFGD"
    MinMissileChance 0
    RenderStyle None
    ReactionTime 25
    States
    {
    Spawn:
	   NULL A 0 A_CountDown
       XXXX A 1 A_Look
//    loop
    See:
       XXXX A 0 A_Chase
    Missile:
       XXXX A 0 A_FaceTarget
       XXXX A 0 A_CustomRailgun(random(15,30),0,none,none,RGF_FULLBRIGHT|RGF_SILENT|RGF_NOPIERCING,10,0,"64BFGBallHugeTracerPuff",0,0,0,0,30,0,"64BFGBallHugeTracerTrail")
   Stop
    }
}

